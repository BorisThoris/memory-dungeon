{
    "name": "memory-dungeon",
    "version": "1.0.0",
    "private": true,
    "author": "Memory Dungeon",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=22.9.0"
    },
    "license": "UNLICENSED",
    "description": "Windows-first Steam desktop arcade rebuild of Memory Dungeon.",
    "main": "dist-electron/main/index.js",
    "scripts": {
        "dev": "concurrently -k \"yarn dev:renderer\" \"yarn dev:electron:watch\" \"yarn dev:electron\"",
        "dev:renderer": "vite",
        "demo:browser": "vite --host 127.0.0.1 --port 4102",
        "portfolio:smoke": "yarn typecheck && yarn test:e2e:demo-readiness",
        "dev:electron:watch": "tsup --config tsup.config.ts --watch",
        "dev:electron": "wait-on tcp:5173 file:dist-electron/main/index.js file:dist-electron/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electronmon dist-electron/main/index.js",
        "build": "yarn clean && yarn build:renderer && yarn build:electron",
        "build:cloudflare": "yarn build:renderer",
        "build:renderer": "vite build",
        "analyze:bundle": "cross-env VITE_BUNDLE_ANALYZE=1 VITE_OUT_DIR=dist-analyze vite build",
        "build:renderer:locked-dist": "cross-env VITE_SKIP_EMPTY_OUT_DIR=1 vite build",
        "build:renderer:alt-out": "cross-env VITE_OUT_DIR=dist-build vite build",
        "build:electron": "tsup --config tsup.config.ts",
        "clean": "rimraf dist dist-build dist-electron release",
        "typecheck": "tsc --noEmit",
        "typecheck:shared": "tsc -p tsconfig.shared.json --noEmit",
        "graph:project": "node scripts/graph-project.mjs",
        "blueprint:codegen": "node scripts/blueprint-codegen.mjs",
        "lint": "eslint . && node scripts/check-test-file-extensions.mjs",
        "verify": "yarn typecheck && yarn test",
        "ci": "yarn fullcheck",
        "depcheck": "depcheck",
        "knip": "cross-env NODE_OPTIONS=--experimental-require-module knip --include files,dependencies,unlisted,unresolved --no-config-hints",
        "knip:exports": "cross-env NODE_OPTIONS=--experimental-require-module knip --exports --no-config-hints --max-show-issues 150",
        "knip:production": "cross-env NODE_OPTIONS=--experimental-require-module knip --production --include files,dependencies,unlisted,unresolved --no-config-hints",
        "audit:renderer-assets": "node scripts/audit-renderer-assets.mjs",
        "fullcheck": "yarn lint && yarn verify",
        "gate:gameplay": "yarn typecheck:shared && yarn vitest run src/shared/game.test.ts src/shared/softlock-fairness.test.ts src/shared/relics.test.ts src/shared/balance-simulation.test.ts src/shared/sim-endless-output.test.ts src/shared/exploit-surface.test.ts src/shared/route-foundation.test.ts src/shared/p2-contracts.test.ts src/shared/economy-ledger.test.ts && yarn sim:endless --floors=1000 --seed=42001 && yarn test",
        "gate:long-run": "yarn typecheck:shared && yarn vitest run src/shared/long-run-depth.test.ts src/shared/boss-encounters.test.ts src/shared/run-map.test.ts src/shared/relics.test.ts src/shared/balance-simulation.test.ts src/shared/sim-endless-output.test.ts src/shared/economy-ledger.test.ts && tsx scripts/gate-long-run.ts --floors=48 && yarn sim:endless --floors=1000 --seed=42001",
        "gate:readability-long-run": "yarn typecheck:shared && yarn vitest run src/shared/long-run-feedback.test.ts src/shared/findables.test.ts src/shared/mechanic-feedback.test.ts src/shared/hazard-tiles.test.ts src/shared/softlock-fairness.test.ts src/shared/game.test.ts && yarn gate:long-run",
        "gate:long-run-ui-feedback": "yarn typecheck && yarn vitest run src/shared/long-run-feedback.test.ts src/shared/findables.test.ts src/shared/mechanics-encyclopedia.test.ts src/renderer/components/GameplayHudBar.test.tsx src/renderer/hooks/useHudPoliteLiveAnnouncement.test.ts && playwright test e2e/long-run-feedback-hud.spec.ts --workers=1 && yarn gate:readability-long-run",
        "sim:endless": "tsx scripts/sim-endless.ts",
        "test": "vitest run",
        "test:gameplay:properties": "vitest run src/shared/gameplay-property-invariants.test.ts src/shared/puzzle-import.test.ts --testTimeout=10000",
        "test:gameplay:properties:long": "cross-env GAMEPLAY_PROPERTY_RUNS=1000 vitest run src/shared/gameplay-property-invariants.test.ts src/shared/puzzle-import.test.ts --testTimeout=30000",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:demo-readiness": "playwright test e2e/demo-readiness.spec.ts --workers=1",
        "test:e2e:illustration-regression": "playwright test e2e/tile-card-face-illustration-regression.spec.ts --workers=1",
        "test:e2e:a11y": "playwright test e2e/a11y-scoped-routes.spec.ts --workers=1",
        "test:e2e:visual": "yarn test:e2e:visual:device-grid",
        "test:e2e:visual:device-grid": "playwright test e2e/visual-inventory-capture.spec.ts --workers=1",
        "test:e2e:visual:device-grid:shard1": "playwright test e2e/visual-inventory-capture.spec.ts --shard=1/4",
        "test:e2e:visual:device-grid:shard2": "playwright test e2e/visual-inventory-capture.spec.ts --shard=2/4",
        "test:e2e:visual:device-grid:shard3": "playwright test e2e/visual-inventory-capture.spec.ts --shard=3/4",
        "test:e2e:visual:device-grid:shard4": "playwright test e2e/visual-inventory-capture.spec.ts --shard=4/4",
        "test:e2e:visual:smoke": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --workers=1",
        "test:e2e:visual:smoke:shard1": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=1/3",
        "test:e2e:visual:smoke:shard2": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=2/3",
        "test:e2e:visual:smoke:shard3": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=3/3",
        "test:e2e:mobile-layout": "playwright test e2e/mobile-layout.spec.ts --workers=1",
        "test:e2e:playable-path:audit": "playwright test e2e/playable-path-navigation.spec.ts --workers=1",
        "test:e2e:playable-path:readability": "playwright test e2e/gameplay-readability.spec.ts --workers=1",
        "test:e2e:playable-path:full": "playwright test e2e/playable-path-navigation.spec.ts e2e/playable-path-mode-matrix.spec.ts e2e/playable-path-interludes.spec.ts e2e/gameplay-readability.spec.ts --workers=1",
        "test:e2e:renderer-qa": "yarn test:e2e:renderer-qa:full",
        "test:e2e:renderer-qa:full": "playwright test e2e/mobile-layout.spec.ts e2e/navigation-flow.spec.ts e2e/playable-path-navigation.spec.ts e2e/playable-path-mode-matrix.spec.ts e2e/playable-path-interludes.spec.ts e2e/gameplay-readability.spec.ts e2e/long-run-feedback-hud.spec.ts e2e/scholar-contract.spec.ts e2e/wild-run.spec.ts e2e/tile-card-face-dom.spec.ts e2e/tile-card-face-webgl.spec.ts e2e/tile-board-raycast.spec.ts --workers=1",
        "capture:ui-audit": "cross-env VISUAL_CAPTURE_ROOT=docs/visual-capture yarn test:e2e:visual:device-grid",
        "capture:visual-inventory": "yarn capture:ui-audit",
        "capture:ui-design-reference": "playwright test e2e/ui-design-reference.spec.ts --workers=1",
        "capture:endproduct-parity": "cross-env VISUAL_CAPTURE_ROOT=docs/visual-capture/endproduct-parity playwright test e2e/visual-endproduct-parity.spec.ts --workers=1",
        "capture:matched-flame": "playwright test e2e/capture-matched-flame.spec.ts --workers=1",
        "capture:gameplay-audit": "cross-env VISUAL_CAPTURE_ROOT=test-results/gameplay-visual-audit playwright test e2e/gameplay-visual-audit.spec.ts --workers=1 && cross-env GAMEPLAY_AUDIT_ROOT=test-results/gameplay-visual-audit node scripts/generate-gameplay-visual-audit-md.mjs",
        "benchmark:illustration-regression": "cross-env RUN_ILLUSTRATION_BENCHMARK=1 playwright test e2e/tile-card-face-illustration-benchmark.spec.ts --workers=1",
        "docs:ui-audit": "node scripts/generate-visual-inventory-md.mjs",
        "docs:visual-inventory": "yarn docs:ui-audit",
        "docs:mechanics-appendix": "cross-env NODE_OPTIONS= tsx scripts/run-mechanics-appendix.ts",
        "assets:choose-path-bg": "node scripts/generate-choose-path-background.mjs",
        "wip:extract-endproduct": "node scripts/extract-endproduct-wip-assets.mjs",
        "wip:extract-endproduct:react": "node scripts/extract-endproduct-wip-assets.mjs --emit-react",
        "wip:extract-endproduct:png-only": "node scripts/extract-endproduct-wip-assets.mjs --no-svg",
        "imagegen": "node scripts/card-pipeline/image_gen.mjs",
        "card-backs:local": "py -3 scripts/card-pipeline/batch_local_card_backs.py",
        "card-backs:local:dry": "py -3 scripts/card-pipeline/batch_local_card_backs.py --dry-run",
        "face-panels:local": "py -3 scripts/card-pipeline/batch_local_face_panels.py",
        "face-panels:local:dry": "py -3 scripts/card-pipeline/batch_local_face_panels.py --dry-run",
        "audio:ace-step:batch": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.example.json",
        "audio:ace-step:batch:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.example.json",
        "audio:ace-step:smoke": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.smoke-one.json",
        "audio:ace-step:hybrid": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.hybrid-ambient.json",
        "audio:ace-step:hybrid:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.hybrid-ambient.json",
        "audio:ace-step:app": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json",
        "audio:ace-step:app:wav": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --audio-format wav",
        "audio:ace-step:app:high": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality high",
        "audio:ace-step:app:max": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality max",
        "audio:ace-step:app:hq-variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality high --variants 3",
        "audio:ace-step:app:max-variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality max --variants 3",
        "audio:ace-step:app:variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --variants 3",
        "audio:ace-step:app:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json",
        "audio:install:ace-app-outputs": "node scripts/audio-pipeline/install-ace-app-outputs.mjs",
        "audio:placeholders": "node scripts/audio-pipeline/generate-procedural-sfx-wavs.mjs",
        "audio:materialize-references": "node scripts/audio-pipeline/materialize-reference-audio.mjs",
        "audio:materialize-references-from-pack": "node scripts/audio-pipeline/materialize-reference-audio-from-pack.mjs",
        "audio:apply-reference-coverage": "node scripts/audio-pipeline/apply-reference-coverage-priority.mjs",
        "audio:prep-ace-app": "yarn audio:placeholders && yarn audio:materialize-references",
        "gen:face-panel-raster-urls": "node scripts/gen-face-panel-raster-urls.mjs",
        "card-texture:ideal": "node scripts/card-pipeline/print-card-texture-ideal.mjs",
        "card-texture:ai-brief": "node scripts/card-pipeline/print-card-texture-ideal.mjs --ai-brief",
        "capture:ui-vs-assets": "node scripts/card-pipeline/capture-ui-vs-asset-screens.mjs",
        "png:trim-bbox": "node scripts/card-pipeline/trim-png-bounding-box.mjs",
        "optimize:card-front": "node scripts/svgo-optimize-card-front.mjs",
        "generate:card-plates": "tsx scripts/generate-card-plates.ts",
        "build:card-illustration-manifest": "node scripts/build-card-illustration-manifest.mjs",
        "regenerate:illustration-regression": "cross-env UPDATE_ILLUSTRATION_FIXTURES=1 playwright test e2e/tile-card-face-illustration-regression.spec.ts --workers=1",
        "bake:procedural-set": "tsx scripts/bake-procedural-illustration-set.ts",
        "test:e2e:ui": "playwright test --ui",
        "package:dir": "yarn build && electron-builder --dir",
        "package:win": "yarn build && electron-builder --win nsis",
        "postinstall": "node scripts/postinstall.cjs"
    },
    "dependencies": {
        "@cross-repo-libs/notifications": "file:./packages/notifications",
        "@fontsource/cinzel": "5.2.5",
        "@fontsource/source-sans-3": "5.2.5",
        "@react-three/fiber": "^9.5.0",
        "@react-three/postprocessing": "^3.0.4",
        "electron-store": "11.0.2",
        "opentype.js": "^1.3.4",
        "pixi.js": "8.17.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "steamworks.js": "0.4.0",
        "three": "^0.183.2",
        "xstate": "^5.32.0",
        "zod": "^4.4.3",
        "zustand": "5.0.12"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.11.0",
        "@eslint/js": "9.38.0",
        "@fit-screen/react": "^1.0.2",
        "@playwright/test": "1.57.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "25.5.0",
        "@types/opentype.js": "^1.3.9",
        "@types/pixelmatch": "^5.2.6",
        "@types/pngjs": "^6.0.5",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/three": "^0.184.0",
        "@vitejs/plugin-react": "4.7.0",
        "@xyflow/react": "^12.10.2",
        "baseline-browser-mapping": "^2.10.23",
        "concurrently": "9.2.1",
        "cross-env": "10.1.0",
        "depcheck": "^1.4.7",
        "electron": "41.1.0",
        "electron-builder": "26.8.1",
        "electronmon": "2.0.4",
        "eslint": "9.38.0",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "fast-check": "^4.8.0",
        "globals": "17.4.0",
        "happy-dom": "^20.0.0",
        "imagetracerjs": "^1.2.6",
        "knip": "^6.5.0",
        "pixelmatch": "5.3.0",
        "playwright": "1.57.0",
        "playwright-core": "1.57.0",
        "pngjs": "^7.0.0",
        "rimraf": "6.1.3",
        "rollup-plugin-visualizer": "^7.0.1",
        "svgo": "^4.0.1",
        "ts-morph": "^28.0.0",
        "tsup": "8.5.1",
        "tsx": "^4.21.0",
        "typescript": "6.0.2",
        "typescript-eslint": "8.57.2",
        "vite": "6.4.1",
        "vitest": "4.1.2",
        "wait-on": "9.0.4"
    },
    "resolutions": {
        "**/@xmldom/xmldom": "0.8.13",
        "**/ajv-formats/ajv": "8.18.0",
        "baseline-browser-mapping": "2.10.23",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "zustand": "5.0.12"
    },
    "build": {
        "appId": "com.memorydungeon.steam",
        "productName": "Memory Dungeon",
        "asar": true,
        "asarUnpack": [
            "node_modules/steamworks.js/dist/win64/**/*"
        ],
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "extraFiles": [
            {
                "from": "steam_appid.txt",
                "to": "."
            },
            {
                "from": "node_modules/steamworks.js/dist/win64",
                "to": ".",
                "filter": [
                    "steam_api64.dll"
                ]
            }
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "win": {
            "icon": "icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false
        }
    }
}
