{
    "name": "memory-dungeon",
    "version": "1.0.0",
    "private": true,
    "author": "Memory Dungeon",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=22.9.0"
    },
    "license": "UNLICENSED",
    "description": "Windows-first Steam desktop arcade rebuild of Memory Dungeon.",
    "main": "dist-electron/main/index.js",
    "scripts": {
        "dev": "concurrently -k \"yarn dev:renderer\" \"yarn dev:electron:watch\" \"yarn dev:electron\"",
        "dev:renderer": "vite",
        "demo:browser": "vite --host 127.0.0.1 --port 4102",
        "portfolio:smoke": "yarn typecheck && yarn test:e2e:demo-readiness",
        "dev:electron:watch": "tsup --config tsup.config.ts --watch",
        "dev:electron": "wait-on tcp:5173 file:dist-electron/main/index.js file:dist-electron/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electronmon dist-electron/main/index.js",
        "build": "yarn clean && yarn build:renderer && yarn build:electron",
        "build:cloudflare": "yarn build:renderer",
        "build:renderer": "vite build",
        "build:renderer:sourcemap": "cross-env VITE_SOURCEMAP=1 vite build",
        "analyze:bundle": "cross-env VITE_BUNDLE_ANALYZE=1 VITE_OUT_DIR=dist-analyze vite build",
        "build:renderer:locked-dist": "cross-env VITE_SKIP_EMPTY_OUT_DIR=1 vite build",
        "build:renderer:alt-out": "cross-env VITE_OUT_DIR=dist-build vite build",
        "build:electron": "tsup --config tsup.config.ts",
        "build:electron:sourcemap": "cross-env ELECTRON_SOURCEMAP=1 tsup --config tsup.config.ts",
        "clean": "rimraf dist dist-build dist-electron release",
        "typecheck": "tsc --noEmit",
        "typecheck:shared": "tsc -p tsconfig.shared.json --noEmit",
        "graph:project": "node scripts/graph-project.mjs",
        "graph:systems": "node scripts/system-diagrams.mjs",
        "ai:model": "node scripts/ai-repo-model.mjs --write",
        "ai:model:check": "node scripts/ai-repo-model.mjs --check",
        "ai:model:query": "node scripts/ai-repo-model.mjs --query",
        "sim:gameplay-core": "tsx scripts/sim-gameplay-core.ts",
        "blueprint:codegen": "node scripts/blueprint-codegen.mjs",
        "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint . && node scripts/check-test-file-extensions.mjs",
        "verify": "yarn typecheck && yarn test",
        "ci": "yarn fullcheck",
        "depcheck": "depcheck",
        "knip": "cross-env NODE_OPTIONS=--experimental-require-module knip --include files,dependencies,unlisted,unresolved --no-config-hints",
        "knip:exports": "cross-env NODE_OPTIONS=--experimental-require-module knip --exports --no-config-hints --max-show-issues 150",
        "knip:production": "cross-env NODE_OPTIONS=--experimental-require-module knip --production --use-tsconfig-files --include files,dependencies,unlisted,unresolved --no-config-hints",
        "gate:package-hygiene": "yarn vitest run src/shared/check-depcheck-clean-script.test.ts && node scripts/check-depcheck-clean.mjs && yarn knip --reporter compact && yarn knip:production --reporter compact && yarn knip:exports --reporter compact",
        "audit:bundle": "node scripts/check-renderer-bundle-budget.mjs dist-build",
        "audit:dungeon-topology": "tsx scripts/audit-dungeon-topology.ts",
        "audit:dungeon-topology:json": "tsx scripts/audit-dungeon-topology.ts --json",
        "audit:dungeon-topology:gate": "tsx scripts/audit-dungeon-topology.ts --quiet",
        "audit:dungeon-topology:stress": "tsx scripts/audit-dungeon-topology.ts --quiet --requireFullScheduleCoverage --floors=250 --stressSeeds=64",
        "audit:renderer-assets": "node scripts/audit-renderer-assets.mjs",
        "audit:summary": "node scripts/audit-summary.mjs",
        "fullcheck": "yarn lint && yarn gate:security && yarn gate:desktop-build && yarn gate:build-output && yarn gate:systems && yarn verify",
        "gate:action-loop": "yarn typecheck:shared && yarn vitest run src/shared/game.test.ts src/shared/playthrough-solver.test.ts src/shared/softlock-fairness.test.ts src/shared/softlock-generator-contract.test.ts src/shared/run-progression-repair.test.ts src/shared/dungeon-topology.test.ts src/shared/dungeon-topology-audit-script.test.ts src/shared/dungeon-topology-runtime-boundary.test.ts src/shared/gameplay-interaction-graph.test.ts src/shared/board-inspection.test.ts src/shared/enemy-hazard-board-rules.test.ts src/shared/dungeon-board-status.test.ts src/shared/board-power-actions.test.ts src/shared/hazard-tiles.test.ts src/shared/tile-trait-rules.test.ts src/shared/exploit-surface.test.ts",
    "gate:gameplay-core": "yarn typecheck && yarn vitest run src/shared/gameplay-core.test.ts src/shared/gameplay-core-simulation.test.ts src/shared/gameplay-journal.test.ts src/shared/bonus-rewards.test.ts src/shared/dungeon-boss-clear-rules.test.ts src/shared/secondary-objective-rules.test.ts src/shared/score-parasite-rules.test.ts src/shared/hazard-tile-effect-rules.test.ts src/shared/next-floor-run-state-rules.test.ts src/shared/risk-wager-rules.test.ts src/shared/run-summary-rules.test.ts src/shared/save-data.test.ts src/shared/version-gate.test.ts src/shared/gameplay-interaction-graph.test.ts src/renderer/store/gameplayFeedbackAdapter.test.ts src/renderer/store/riskWagerSurfaceState.test.ts src/renderer/store/runSurfaceState.test.ts src/renderer/store/tilePressController.test.ts src/renderer/store/relicOfferSurfaceState.test.ts src/renderer/store/sideRoomSurfaceState.test.ts src/renderer/store/sideRoomActionController.test.ts src/renderer/hooks/useHudPoliteLiveAnnouncement.test.ts && yarn sim:gameplay-core --steps=384 --seed=42001",
        "gate:rewards-economy": "yarn typecheck:shared && yarn vitest run src/shared/bonus-rewards.test.ts src/shared/shop-rules.test.ts src/shared/relic-offer-rules.test.ts src/shared/relics.test.ts src/shared/economy-ledger.test.ts src/shared/run-economy.test.ts src/shared/balance-simulation.test.ts",
        "gate:navigation": "yarn typecheck:shared && yarn vitest run src/shared/run-map.test.ts src/shared/route-foundation.test.ts src/shared/game.test.ts src/renderer/store/useAppStore.test.ts src/renderer/components/ChooseYourPathScreen.test.tsx src/renderer/components/SideRoomScreen.test.tsx src/renderer/App.test.tsx",
        "gate:systems": "yarn vitest run src/shared/gate-changed.test.ts src/shared/ai-repo-model.test.ts && yarn ai:model:check && yarn gate:gameplay-core && yarn gate:action-loop && yarn gate:rewards-economy && yarn gate:navigation && yarn gate:module-graph && yarn docs:system-diagrams:check && yarn docs:release-checklist:check && yarn audit:store-reachability && yarn audit:dungeon-topology:gate && yarn gate:sim-health && yarn gate:sim-softlock-seeds",
        "gate:security": "yarn vitest run src/shared/audit-summary-script.test.ts && yarn audit:summary",
        "gate:build-output": "yarn vitest run src/shared/renderer-bundle-budget-script.test.ts && yarn build:renderer:alt-out && yarn audit:bundle",
        "gate:desktop-build": "yarn build:electron",
        "gate:changed": "node scripts/gate-changed.mjs",
        "gate:sim-health": "yarn sim:endless --floors=1000 --seed=42001 --check",
        "gate:sim-softlock-seeds": "tsx scripts/gate-softlock-seeds.ts",
        "gate:sim-softlock-stress": "tsx scripts/gate-softlock-seeds.ts --floors=250 --stressSeeds=64",
        "gate:softlock-full": "yarn audit:dungeon-topology:stress && yarn gate:sim-softlock-stress",
        "gate:persistence": "yarn vitest run src/main/persistence.test.ts src/main/persistence-write-error.test.ts && yarn typecheck",
        "gate:renderer-input": "yarn vitest run src/renderer/components/tileBoardDomAccessibility.test.ts src/renderer/components/tileBoardPointerPick.test.ts src/renderer/components/tileBoardWebglBoundary.test.tsx src/renderer/store/levelCompleteSurfaceState.test.ts src/renderer/store/runResolutionController.test.ts src/renderer/store/useAppStore.test.ts",
        "gate:audio-feedback": "yarn vitest run src/renderer/audio/audioInteractionCoverage.test.ts src/renderer/audio/audioMixDuckingPolicy.test.ts src/renderer/audio/dungeonAudioEventCoverage.test.ts src/renderer/audio/gameplayMusic.test.ts src/renderer/audio/gameSfx.test.ts src/renderer/audio/preloadAudioBuffers.test.ts src/renderer/audio/uiSfx.test.ts src/renderer/hooks/useHudPoliteLiveAnnouncement.test.ts src/renderer/components/GameScreen.test.tsx",
        "gate:asset-rendering": "yarn audit:renderer-assets && yarn vitest run src/renderer/cardFace/cardIllustrationDraw.test.ts src/renderer/components/tileTextures.test.ts src/renderer/components/tileBoardReadability.test.ts src/renderer/components/tileBoardRows.test.ts",
        "gate:gameplay": "yarn typecheck:shared && yarn vitest run src/shared/game.test.ts src/shared/softlock-fairness.test.ts src/shared/softlock-generator-contract.test.ts src/shared/relics.test.ts src/shared/balance-simulation.test.ts src/shared/sim-endless-output.test.ts src/shared/exploit-surface.test.ts src/shared/route-foundation.test.ts src/shared/p2-contracts.test.ts src/shared/economy-ledger.test.ts && yarn sim:endless --floors=1000 --seed=42001 && yarn test",
        "gate:long-run": "yarn typecheck:shared && yarn vitest run src/shared/gate-long-run-script.test.ts src/shared/seed-sweep-options.test.ts src/shared/long-run-depth.test.ts src/shared/boss-encounters.test.ts src/shared/run-map.test.ts src/shared/relics.test.ts src/shared/balance-simulation.test.ts src/shared/sim-endless-output.test.ts src/shared/economy-ledger.test.ts --maxWorkers=1 && tsx scripts/gate-long-run.ts --floors=48 && yarn sim:endless --floors=1000 --seed=42001",
        "gate:readability-long-run": "yarn typecheck:shared && yarn vitest run src/shared/long-run-feedback.test.ts src/shared/findables.test.ts src/shared/mechanic-feedback.test.ts src/shared/hazard-tiles.test.ts src/shared/softlock-fairness.test.ts src/shared/game.test.ts --maxWorkers=2 && yarn gate:long-run",
        "gate:long-run-ui-feedback": "yarn typecheck && yarn vitest run src/shared/long-run-feedback.test.ts src/shared/findables.test.ts src/shared/mechanics-encyclopedia.test.ts src/renderer/components/GameplayHudBar.test.tsx src/renderer/hooks/useHudPoliteLiveAnnouncement.test.ts --maxWorkers=2 && playwright test e2e/long-run-feedback-hud.spec.ts --workers=1 && yarn gate:readability-long-run",
        "sim:endless": "tsx scripts/sim-endless.ts",
        "test": "vitest run --maxWorkers=2",
        "test:gameplay:properties": "vitest run src/shared/gameplay-property-invariants.test.ts src/shared/puzzle-import.test.ts --testTimeout=10000",
        "test:gameplay:properties:long": "cross-env GAMEPLAY_PROPERTY_RUNS=1000 vitest run src/shared/gameplay-property-invariants.test.ts src/shared/puzzle-import.test.ts --testTimeout=30000",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:demo-readiness": "playwright test e2e/demo-readiness.spec.ts --workers=1",
        "test:e2e:blueprint": "playwright test e2e/blueprint-explorer.spec.ts --workers=1",
        "test:e2e:illustration-regression": "playwright test e2e/tile-card-face-illustration-regression.spec.ts --workers=1",
        "test:e2e:a11y": "playwright test e2e/a11y-scoped-routes.spec.ts --workers=1",
        "audit:copy-locality": "tsx scripts/copy-locality.ts",
        "audit:store-reachability": "tsx scripts/store-action-reachability.ts",
        "steam:cloud-config": "tsx scripts/steam-cloud-config.ts",
        "test:e2e:startup": "playwright test e2e/startup-budget.spec.ts --workers=1",
        "test:e2e:ui-fit": "playwright test e2e/ui-fit-contract.spec.ts --workers=1",
        "test:e2e:controller": "playwright test e2e/controller-navigation.spec.ts --workers=1",
        "test:e2e:visual": "yarn test:e2e:visual:device-grid",
        "test:e2e:visual:device-grid": "playwright test e2e/visual-inventory-capture.spec.ts --workers=1",
        "test:e2e:visual:device-grid:shard1": "playwright test e2e/visual-inventory-capture.spec.ts --shard=1/4",
        "test:e2e:visual:device-grid:shard2": "playwright test e2e/visual-inventory-capture.spec.ts --shard=2/4",
        "test:e2e:visual:device-grid:shard3": "playwright test e2e/visual-inventory-capture.spec.ts --shard=3/4",
        "test:e2e:visual:device-grid:shard4": "playwright test e2e/visual-inventory-capture.spec.ts --shard=4/4",
        "test:e2e:visual:smoke": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --workers=1",
        "test:e2e:visual:smoke:shard1": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=1/3",
        "test:e2e:visual:smoke:shard2": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=2/3",
        "test:e2e:visual:smoke:shard3": "playwright test e2e/visual-screens.mobile.spec.ts e2e/visual-screens.standard.spec.ts --shard=3/3",
        "test:e2e:mobile-layout": "playwright test e2e/mobile-layout.spec.ts --workers=1",
        "test:e2e:playable-path:audit": "playwright test e2e/playable-path-navigation.spec.ts --workers=1",
        "test:e2e:playable-path:readability": "playwright test e2e/gameplay-readability.spec.ts --workers=1",
        "test:e2e:board-3d-value": "playwright test e2e/dungeon-board-3d-value.spec.ts --workers=1",
        "test:e2e:browser-smoke": "yarn test:e2e:browser-smoke:core",
        "test:e2e:browser-smoke:full": "yarn test:e2e:browser-smoke:core && yarn test:e2e:browser-smoke:routes",
        "test:e2e:browser-smoke:core": "yarn test:e2e:demo-readiness && yarn playwright test e2e/playable-path-navigation.spec.ts --workers=1 && yarn test:e2e:board-3d-value",
        "test:e2e:browser-smoke:routes": "yarn playwright test e2e/playable-path-mode-matrix.spec.ts e2e/playable-path-interludes.spec.ts e2e/gameplay-readability.spec.ts e2e/long-run-feedback-hud.spec.ts --workers=1",
        "test:e2e:playable-path:full": "playwright test e2e/playable-path-navigation.spec.ts e2e/playable-path-mode-matrix.spec.ts e2e/playable-path-interludes.spec.ts e2e/gameplay-readability.spec.ts --workers=1",
        "test:e2e:renderer-qa": "yarn test:e2e:renderer-qa:full",
        "test:e2e:renderer-qa:full": "yarn test:e2e:renderer-qa:layout && yarn test:e2e:renderer-qa:navigation && yarn test:e2e:renderer-qa:interludes && yarn test:e2e:renderer-qa:3d",
        "test:e2e:renderer-qa:layout": "playwright test e2e/mobile-layout.spec.ts e2e/gameplay-readability.spec.ts e2e/long-run-feedback-hud.spec.ts --workers=1",
        "test:e2e:renderer-qa:navigation": "playwright test e2e/navigation-flow.spec.ts e2e/playable-path-navigation.spec.ts e2e/playable-path-mode-matrix.spec.ts --workers=1",
        "test:e2e:renderer-qa:interludes": "playwright test e2e/playable-path-interludes.spec.ts e2e/scholar-contract.spec.ts e2e/wild-run.spec.ts --workers=1",
        "test:e2e:renderer-qa:3d": "playwright test e2e/dungeon-board-3d-value.spec.ts e2e/tile-card-face-dom.spec.ts e2e/tile-card-face-webgl.spec.ts e2e/tile-board-raycast.spec.ts --workers=1",
        "capture:ui-audit": "cross-env VISUAL_CAPTURE_ROOT=docs/visual-capture yarn test:e2e:visual:device-grid",
        "capture:visual-inventory": "yarn capture:ui-audit",
        "capture:ui-design-reference": "playwright test e2e/ui-design-reference.spec.ts --workers=1",
        "capture:endproduct-parity": "cross-env VISUAL_CAPTURE_ROOT=docs/visual-capture/endproduct-parity playwright test e2e/visual-endproduct-parity.spec.ts --workers=1",
        "capture:matched-flame": "playwright test e2e/capture-matched-flame.spec.ts --workers=1",
        "capture:gameplay-audit": "cross-env VISUAL_CAPTURE_ROOT=test-results/gameplay-visual-audit playwright test e2e/gameplay-visual-audit.spec.ts --workers=1 && cross-env GAMEPLAY_AUDIT_ROOT=test-results/gameplay-visual-audit node scripts/generate-gameplay-visual-audit-md.mjs",
        "benchmark:illustration-regression": "cross-env RUN_ILLUSTRATION_BENCHMARK=1 playwright test e2e/tile-card-face-illustration-benchmark.spec.ts --workers=1",
        "docs:ui-audit": "node scripts/generate-visual-inventory-md.mjs",
        "docs:visual-inventory": "yarn docs:ui-audit",
        "docs:mechanics-appendix": "cross-env NODE_OPTIONS= tsx scripts/run-mechanics-appendix.ts",
        "docs:system-diagrams": "node scripts/system-diagrams.mjs --write-docs",
        "gate:module-graph": "tsx scripts/check-module-graph-entry.ts",
        "docs:release-checklist": "tsx scripts/release-checklist.ts --write",
        "docs:release-checklist:check": "tsx scripts/release-checklist.ts --check",
        "release:checklist": "tsx scripts/release-checklist.ts",
        "docs:system-diagrams:check": "node scripts/system-diagrams.mjs --check-docs",
        "assets:choose-path-bg": "node scripts/generate-choose-path-background.mjs",
        "assets:ui-backgrounds:export-runtime-webp": "node scripts/card-pipeline/export-ui-background-webp.mjs",
        "wip:extract-endproduct": "node scripts/extract-endproduct-wip-assets.mjs",
        "wip:extract-endproduct:react": "node scripts/extract-endproduct-wip-assets.mjs --emit-react",
        "wip:extract-endproduct:png-only": "node scripts/extract-endproduct-wip-assets.mjs --no-svg",
        "imagegen": "node scripts/card-pipeline/image_gen.mjs",
        "card-backs:local": "py -3 scripts/card-pipeline/batch_local_card_backs.py",
        "card-backs:local:dry": "py -3 scripts/card-pipeline/batch_local_card_backs.py --dry-run",
        "face-panels:local": "py -3 scripts/card-pipeline/batch_local_face_panels.py",
        "face-panels:local:dry": "py -3 scripts/card-pipeline/batch_local_face_panels.py --dry-run",
        "face-panels:export-runtime-webp": "node scripts/card-pipeline/export-face-panel-webp.mjs && yarn gen:face-panel-raster-urls",
        "card-normals:export-runtime-webp": "node scripts/card-pipeline/export-card-normal-webp.mjs",
        "audio:ace-step:batch": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.example.json",
        "audio:ace-step:batch:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.example.json",
        "audio:ace-step:smoke": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.smoke-one.json",
        "audio:ace-step:hybrid": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.hybrid-ambient.json",
        "audio:ace-step:hybrid:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.hybrid-ambient.json",
        "audio:ace-step:app": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json",
        "audio:ace-step:app:wav": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --audio-format wav",
        "audio:ace-step:app:high": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality high",
        "audio:ace-step:app:max": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality max",
        "audio:ace-step:app:hq-variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality high --variants 3",
        "audio:ace-step:app:max-variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --quality max --variants 3",
        "audio:ace-step:app:variants": "node scripts/audio-pipeline/run-ace-batch.mjs --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json --variants 3",
        "audio:ace-step:app:dry": "node scripts/audio-pipeline/run-ace-batch.mjs --dry-run --jobs scripts/audio-pipeline/jobs.memory-dungeon-app-audio.json",
        "audio:install:ace-app-outputs": "node scripts/audio-pipeline/install-ace-app-outputs.mjs && yarn audio:export-runtime-ogg",
        "audio:placeholders": "node scripts/audio-pipeline/generate-procedural-sfx-wavs.mjs",
        "audio:export-runtime-ogg": "node scripts/audio-pipeline/export-runtime-ogg.mjs",
        "audio:materialize-references": "node scripts/audio-pipeline/materialize-reference-audio.mjs",
        "audio:materialize-references-from-pack": "node scripts/audio-pipeline/materialize-reference-audio-from-pack.mjs",
        "audio:apply-reference-coverage": "node scripts/audio-pipeline/apply-reference-coverage-priority.mjs",
        "audio:prep-ace-app": "yarn audio:placeholders && yarn audio:export-runtime-ogg && yarn audio:materialize-references",
        "gen:face-panel-raster-urls": "node scripts/gen-face-panel-raster-urls.mjs",
        "card-texture:ideal": "node scripts/card-pipeline/print-card-texture-ideal.mjs",
        "card-texture:ai-brief": "node scripts/card-pipeline/print-card-texture-ideal.mjs --ai-brief",
        "capture:ui-vs-assets": "node scripts/card-pipeline/capture-ui-vs-asset-screens.mjs",
        "png:trim-bbox": "node scripts/card-pipeline/trim-png-bounding-box.mjs",
        "optimize:card-front": "node scripts/svgo-optimize-card-front.mjs",
        "generate:card-plates": "tsx scripts/generate-card-plates.ts",
        "build:card-illustration-manifest": "node scripts/build-card-illustration-manifest.mjs",
        "regenerate:illustration-regression": "cross-env UPDATE_ILLUSTRATION_FIXTURES=1 playwright test e2e/tile-card-face-illustration-regression.spec.ts --workers=1",
        "bake:procedural-set": "tsx scripts/bake-procedural-illustration-set.ts",
        "test:e2e:ui": "playwright test --ui",
        "package:dir": "node scripts/write-steam-appid.mjs && yarn build && electron-builder --dir",
        "package:win": "node scripts/write-steam-appid.mjs && yarn build && electron-builder --win nsis",
        "package:win:demo": "cross-env MEMORY_DUNGEON_BUILD_FLAVOUR=demo VITE_BUILD_FLAVOUR=demo node scripts/write-steam-appid.mjs && cross-env VITE_BUILD_FLAVOUR=demo yarn build && electron-builder --win nsis",
        "postinstall": "node scripts/postinstall.cjs"
    },
    "dependencies": {
        "@fontsource/cinzel": "5.2.5",
        "@fontsource/source-sans-3": "5.2.5",
        "@react-three/fiber": "^9.5.0",
        "electron-store": "11.0.2",
        "opentype.js": "^1.3.4",
        "pixi.js": "8.17.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "steamworks.js": "0.4.0",
        "three": "^0.183.2",
        "xstate": "^5.32.0",
        "zod": "^4.4.3",
        "zustand": "5.0.12"
